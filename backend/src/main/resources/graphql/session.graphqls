# =========================
# Session Domain Schema
# =========================

"""
세션 상태
"""
enum SessionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

"""
세션 기본 정보
"""
type SessionItem {
  sessionId: ID!
  sessionTitle: String!
  description: String
  regdate: String!
  moddate: String
  status: SessionStatus!
}

"""
세션 상세 정보
"""
type SessionDetail {
  sessionId: ID!
  sessionTitle: String!
  description: String
  regdate: String!
  moddate: String
  status: SessionStatus!

  documentCount: Int!
  audioCount: Int!

  roundMin: Int
  roundMax: Int
}

"""
세션 목록 조회 응답
"""
type SessionListResponse {
  list: [SessionItem!]!
  totalCount: Int!
}

"""
세션 삭제 결과
"""
type SessionDeleteResult {
  sessionId: ID!
  deleted: Boolean!
  message: String
}

type SessionPage {
  content: [SessionItem!]!
  totalElements: Int!
  totalPages: Int!
  pageNumber: Int!
  pageSize: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
  isFirst: Boolean!
  isLast: Boolean!
}

# =========================
# Input Types
# =========================

input SessionDeleteInput {
  sessionId: ID!
}

input SessionCreateInput {
  sessionTitle: String!
  description: String
}

input SessionUpdateInput {
  sessionId: ID!
  sessionTitle: String
  description: String
}

# =========================
# Queries (EXTEND)
# =========================

extend type Query {

  """
  로그인한 사용자가 생성한 세션 목록 조회
  """
  sessions(
    page: PageRequestInput!
  ): SessionPage!

  """
  특정 세션 상세 조회
  """
  session(sessionId: ID!): SessionDetail!
}

# =========================
# Mutations (EXTEND)
# =========================

extend type Mutation {

  """
  세션 생성
  """
  createSession(input: SessionCreateInput!): SessionItem!

  """
  세션 수정
  """
  updateSession(input: SessionUpdateInput!): SessionItem!

  """
  세션 삭제 (Soft Delete)
  """
  deleteSession(input: SessionDeleteInput!): SessionDeleteResult!
}
