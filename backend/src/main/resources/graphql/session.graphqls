# =========================
# Session Domain Schema
# =========================

"""
세션 상태
"""
enum SessionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

"""
세션 기본 정보
- 네비용
- 목록용
"""
type SessionItem {
  sessionId: ID!
  sessionTitle: String!
  description: String
  regdate: String!
  moddate: String
  status: SessionStatus!
}

"""
세션 상세 정보
"""
type SessionDetail {
  sessionId: ID!
  sessionTitle: String!
  description: String
  regdate: String!
  moddate: String
  status: SessionStatus!

  documentCount: Int!
  audioCount: Int!

  roundMin: Int
  roundMax: Int
}

"""
페이지네이션된 세션 목록
- Workspace 전용
"""
type SessionPage {
  content: [SessionItem!]!

  totalElements: Int!
  totalPages: Int!

  pageNumber: Int!
  pageSize: Int!

  hasNext: Boolean!
  hasPrevious: Boolean!

  isFirst: Boolean!
  isLast: Boolean!
}

"""
세션 삭제 결과
"""
type SessionDeleteResult {
  sessionId: ID!
  deleted: Boolean!
  message: String
}

# =========================
# Input Types
# =========================

"""
세션 생성
"""
input SessionCreateInput {
  sessionTitle: String!
  description: String
}

"""
세션 수정
"""
input SessionUpdateInput {
  sessionId: ID!
  sessionTitle: String
  description: String
}

"""
세션 삭제
"""
input SessionDeleteInput {
  sessionId: ID!
}

# =========================
# Queries
# =========================

extend type Query {

  """
  세션 목록 조회 (페이지네이션)
  - Workspace 화면용
  """
  sessions(
    page: PageRequestInput!
  ): SessionPage!

  """
  세션 목록 조회 (네비용, 페이지네이션 없음)
  - GlobalNav 전용
  """
  mySessions: [SessionItem!]!

  """
  세션 상세 조회
  - 워크스페이스 진입 시 사용
  """
  session(
    sessionId: ID!
  ): SessionDetail!
}

# =========================
# Mutations
# =========================

extend type Mutation {

  """
  세션 생성
  """
  createSession(
    input: SessionCreateInput!
  ): SessionItem!

  """
  세션 수정
  """
  updateSession(
    input: SessionUpdateInput!
  ): SessionItem!

  """
  세션 삭제 (Soft Delete)
  """
  deleteSession(
    input: SessionDeleteInput!
  ): SessionDeleteResult!
}
