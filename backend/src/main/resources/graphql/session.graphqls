# =========================
# Session Domain Schema
# =========================

"""
세션 상태
"""
enum SessionStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

"""
세션 기본 정보
"""
type SessionItem {
  sessionId: ID!
  sessionTitle: String!
  description: String
  createdDate: String!
  status: SessionStatus!
}

"""
세션 상세 정보
"""
type SessionDetail {
  sessionId: ID!
  sessionTitle: String!
  description: String
  createdDate: String!
  status: SessionStatus!

  documentCount: Int!
  audioCount: Int!

  roundMin: Int
  roundMax: Int
}

"""
세션 목록 조회 응답
"""
type SessionListResponse {
  list: [SessionItem!]!
  totalCount: Int!
}

"""
세션 삭제 결과
"""
type SessionDeleteResult {
  deleted: Boolean!
  message: String
}

# =========================
# Input Types
# =========================

input SessionCreateInput {
  sessionTitle: String!
  description: String
}

input SessionUpdateInput {
  sessionId: ID!
  sessionTitle: String
  description: String
}

# =========================
# Queries (EXTEND)
# =========================

extend type Query {

  """
  로그인한 사용자가 생성한 세션 목록 조회
  """
  mySessions(
    page: Int
    size: Int
    sort: String
  ): SessionListResponse!

  """
  특정 세션 상세 조회
  """
  sessionDetail(sessionId: ID!): SessionDetail!
}

# =========================
# Mutations (EXTEND)
# =========================

extend type Mutation {

  """
  세션 생성
  """
  createSession(input: SessionCreateInput!): SessionItem!

  """
  세션 수정
  """
  updateSession(input: SessionUpdateInput!): SessionItem!

  """
  세션 삭제 (Soft Delete)
  """
  deleteSession(sessionId: ID!): SessionDeleteResult!
}
