extend type Query {
  documentSummaryViewByFileId(fileId: ID!): DocumentSummaryView
}

type DocumentSummaryView {
  summaryId: ID
  mainTopic: String
  keyTakeaways: [String]
  sections: [SummarySection]
  finalDocument: String
}

type SummarySection {
  title: String
  content: String
}

enum SummaryStatus {
  REQUESTED
  COMPLETED
  FAILED
}

