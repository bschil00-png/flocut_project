extend type Query {

  """
  summaryId 기준 단건 조회 (COMPLETED만)
  """
  documentSummaryViewBySummaryId(
    summaryId: ID!
  ): DocumentSummaryView

  """
  file + session 기준 최신 COMPLETED 요약 조회
  """
  documentLatestSummaryByFile(
    fileId: ID!
    sessionId: ID!
  ): DocumentSummaryView

  """
  file + session + version 기준 요약 조회
  """
  documentSummaryByVersion(
    fileId: ID!
    sessionId: ID!
    versionNo: Int!
  ): DocumentSummaryView

  """
  요약 히스토리 조회 (상태 전체)
  """
  documentSummaryHistory(
    fileId: ID!
    sessionId: ID!
    page: PageRequestInput!
  ): DocumentSummaryHistoryPage!
}

type DocumentSummaryHistoryPage {
  content: [DocumentSummaryHistoryItem!]!
  totalElements: Int!
  totalPages: Int!
  pageNumber: Int!
  pageSize: Int!
  hasNext: Boolean!
  hasPrevious: Boolean!
  isFirst: Boolean!
  isLast: Boolean!
}


type DocumentSummaryView {
  summaryId: ID
  mainTopic: String
  keyTakeaways: [String]
  sections: [SummarySection]
  finalDocument: String
}

type SummarySection {
  title: String
  content: String
}

type DocumentSummaryHistoryItem {
  summaryId: ID!
  versionNo: Int!
  status: SummaryStatus
  createdAt: String
}

enum SummaryStatus {
  REQUESTED
  COMPLETED
  FAILED
  DELETED
}
