# =========================
# File Domain Schema
# =========================

"""
파일 상태
"""
enum FileStatus {
  UPLOADED
  PARSED
  FAILED
  DELETED
}

"""
파일 목록 아이템
"""
type FileItem {
  fileId: ID!
  fileName: String!
  fileType: String!
  fileSize: Int!      # 🔥 Long → Int
  status: FileStatus!
  regdate: String!
}

# =========================
# Queries (EXTEND)
# =========================

extend type Query {

  """
  로그인한 사용자의 파일 목록 조회
  """
  myFiles: [FileItem!]!
}
